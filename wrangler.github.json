{
  "name": "little-scientists-staging",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/admin*",
      "/api/*",
      "/media/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "little-scientists-staging",
      "database_id": "2f1872b8-0d78-420e-81ed-ad94c5190891",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      "id": "1ea29c4cb5b44b6bb010d9269ab8fb35"
    }
  ],
  "vars": {
    "STAGING": "true",
    "PUBLIC_ORIGIN": "https://little-scientists-staging.littlescientiststaipei.workers.dev",
    "EDITOR_EMAILS": "littlescientiststaipei@gmail.com",
    "ADMIN_DISABLED": "true"
  },
  "account_id": "2491b53698e179a5b1ebc79de114ee96"
}
